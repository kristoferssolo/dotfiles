#!/usr/bin/env python3
"""Pick a random wallpaper and apply it under Hyprland or niri."""

import os
import random
import signal
import subprocess
import sys
import time
from argparse import ArgumentParser, Namespace
from collections.abc import Sequence
from pathlib import Path

WALLPAPER_HOME = Path.home() / "Pictures" / "wallpapers"

# Directories searched for wallpapers. Add a line to pull in another collection.
BG_DIRS: tuple[Path, ...] = (
    WALLPAPER_HOME / "rose-pine",
    WALLPAPER_HOME / "nature",
    WALLPAPER_HOME / "PoE2" / "3880x2160",
    WALLPAPER_HOME / "Linux-Dynamic-Wallpapers",
)

# Still-image formats both hyprpaper and swaybg can load.
IMAGE_SUFFIXES = frozenset(
    {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".jxl", ".tga", ".tif", ".tiff"}
)

SWAYBG_SETTLE_DELAY = 0.5


def parse_args() -> Namespace:
    parser = ArgumentParser(description=__doc__)
    parser.add_argument(
        "dirs",
        nargs="*",
        type=Path,
        help="wallpaper directories to search instead of the built-in list",
    )
    parser.add_argument(
        "-n",
        "--notify",
        action="store_true",
        help="send a desktop notification with the new wallpaper name",
    )
    parser.add_argument(
        "-d",
        "--delay",
        action="store_true",
        help="wait for the new swaybg instance to draw before killing the old one",
    )
    return parser.parse_args()


def notify(summary: str, body: str, *, critical: bool = False) -> None:
    cmd = ["notify-send"]
    if critical:
        cmd += ["--urgency", "critical", "--icon", "dialog-error"]
    cmd += [summary, body]
    subprocess.run(cmd, check=False)


def is_running(name: str) -> bool:
    """True if a process matching `name` exactly is running."""
    return subprocess.run(["pgrep", "-x", name], capture_output=True).returncode == 0


def pids_of(name: str) -> list[int]:
    result = subprocess.run(["pidof", name], capture_output=True, text=True)
    return [int(pid) for pid in result.stdout.split()]


def is_image(path: Path) -> bool:
    return path.suffix.lower() in IMAGE_SUFFIXES and path.is_file()


def pick_wallpaper(dirs: Sequence[Path], exclude: Path | None = None) -> Path | None:
    """Random image from `dirs`, skipping `exclude` if given."""
    candidates = [
        path
        for directory in dirs
        for path in directory.rglob("*")
        if is_image(path) and (exclude is None or path.name != exclude.name)
    ]
    return random.choice(candidates) if candidates else None


def swap_hyprland(dirs: Sequence[Path]) -> None:
    loaded = subprocess.run(
        ["hyprctl", "hyprpaper", "listloaded"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    current = Path(loaded.splitlines()[0]) if loaded else None

    wallpaper = pick_wallpaper(dirs, exclude=current)
    if wallpaper is None:
        return

    subprocess.run(["hyprctl", "hyprpaper", "reload", f",{wallpaper}"], check=True)


def swap_niri(dirs: Sequence[Path], *, want_notify: bool, want_delay: bool) -> None:
    wallpaper = pick_wallpaper(dirs)
    if wallpaper is None:
        return

    if want_notify:
        notify("Wallpaper Changed", wallpaper.name)

    # Grab the running instances first; they sit behind the new one once it starts.
    previous = pids_of("swaybg")

    # Bump only the access time so time-based cycling sees this one as recently used.
    stat = wallpaper.stat()
    os.utime(wallpaper, (time.time(), stat.st_mtime))

    subprocess.Popen(
        ["swaybg", "-i", str(wallpaper)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

    # A new swaybg needs a moment to draw; killing the old one too early flashes.
    if want_delay:
        time.sleep(SWAYBG_SETTLE_DELAY)

    for pid in previous:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass


def main() -> int:
    args = parse_args()
    dirs = args.dirs or BG_DIRS

    if is_running("Hyprland"):
        swap_hyprland(dirs)
    elif is_running("niri"):
        swap_niri(dirs, want_notify=args.notify, want_delay=args.delay)
    else:
        notify(
            "Wallpaper Script Error",
            "No compatible window manager found (Hyprland or Niri required)",
            critical=True,
        )
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
