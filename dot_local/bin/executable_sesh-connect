#!/usr/bin/env bash

session="$({
    sesh list -t -c --icons
    mekle | sed 's|^|󰉋 |'
} | fzf-tmux -p 80%,70% \
    --no-sort --ansi \
    --border-label ' sesh ' \
    --prompt '⚡  ' \
    --header '  ^a all  ^t tmux  ^g configs  ^x projects  ^d tmux kill  ^f find' \
    --bind 'tab:down,btab:up' \
    --bind 'ctrl-a:change-prompt(⚡  )+reload(sesh list -t -c --icons; mekle | sed "s|^|󰉋 |")' \
    --bind 'ctrl-t:change-prompt(🪟  )+reload(sesh list -t --icons)' \
    --bind 'ctrl-g:change-prompt(⚙️  )+reload(sesh list -c --icons)' \
    --bind 'ctrl-x:change-prompt(󰉋  )+reload(mekle | sed "s|^|󰉋 |")' \
    --bind 'ctrl-f:change-prompt(🔎  )+reload(fd -H -d 2 -t d -E .Trash . ~)' \
    --bind 'ctrl-d:execute(tmux kill-session -t {2..})+change-prompt(⚡  )+reload(sesh list -t -c --icons; mekle | sed "s|^|󰉋 |")' \
    --preview-window 'right:55%' \
    --preview 'sesh preview {2..}')"

if [[ -n $session ]]; then
    if [[ $session == "󰉋 "* ]]; then
        session="${session#󰉋 }"
        mekle add "$session"
    fi
    exec sesh connect "$session"
fi
