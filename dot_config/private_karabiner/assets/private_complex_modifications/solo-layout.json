{
    "title": "Solo Layout",
    "rules": [
        {
            "description": "Solo Layout: reserve right Option P/Q for typing, keep left Option shortcuts",
            "manipulators": [
                {
                    "type": "basic",
                    "from": {
                        "key_code": "p",
                        "modifiers": {
                            "mandatory": [
                                "right_option"
                            ],
                            "optional": [
                                "shift",
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "p"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "input_source_if",
                            "input_sources": [
                                {
                                    "input_source_id": "^com\\.kristians\\.keyboardlayout\\.SoloLayout\\.keylayout\\.SoloLayout$"
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "basic",
                    "from": {
                        "key_code": "q",
                        "modifiers": {
                            "mandatory": [
                                "right_option"
                            ],
                            "optional": [
                                "shift",
                                "caps_lock"
                            ]
                        }
                    },
                    "to": [
                        {
                            "key_code": "q"
                        }
                    ],
                    "conditions": [
                        {
                            "type": "input_source_if",
                            "input_sources": [
                                {
                                    "input_source_id": "^com\\.kristians\\.keyboardlayout\\.SoloLayout\\.keylayout\\.SoloLayout$"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
