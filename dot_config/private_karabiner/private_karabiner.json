{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Option+Space: lock the screen",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "spacebar",
                                    "modifiers": {
                                        "mandatory": ["option"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "to": [{ "key_code": "q", "modifiers": ["left_control", "left_command"], "repeat": false }]
                            }
                        ]
                    },
                    {
                        "description": "Left Option+Shift+Q: close the focused window",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "q",
                                    "modifiers": {
                                        "mandatory": ["left_option", "shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "conditions": [
                                    {
                                        "type": "frontmost_application_if",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ],
                                "to": [{ "key_code": "w", "modifiers": ["left_command", "left_shift"], "repeat": false }]
                            },
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "q",
                                    "modifiers": {
                                        "mandatory": ["left_option", "shift"],
                                        "optional": ["caps_lock"]
                                    }
                                },
                                "conditions": [
                                    {
                                        "type": "frontmost_application_unless",
                                        "bundle_identifiers": ["^com\\.mitchellh\\.ghostty$"]
                                    }
                                ],
                                "to": [{ "shell_command": "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command close-focused-window" }]
                            }
                        ]
                    },
                    {
                        "description": "Disable Cmd+H Hide (rev 2)",
                        "manipulators": [
                            {
                                "description": "",
                                "from": {
                                    "key_code": "h",
                                    "modifiers": { "mandatory": ["command"] }
                                },
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Solo Layout: reserve right Option P/Q for typing, keep left Option shortcuts",
                        "manipulators": [
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^com\\.kristians\\.keyboardlayout\\.SoloLayout\\.keylayout\\.SoloLayout$" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "p",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["shift", "caps_lock"]
                                    }
                                },
                                "to": [{ "key_code": "p" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [
                                    {
                                        "input_sources": [{ "input_source_id": "^com\\.kristians\\.keyboardlayout\\.SoloLayout\\.keylayout\\.SoloLayout$" }],
                                        "type": "input_source_if"
                                    }
                                ],
                                "from": {
                                    "key_code": "q",
                                    "modifiers": {
                                        "mandatory": ["right_option"],
                                        "optional": ["shift", "caps_lock"]
                                    }
                                },
                                "to": [{ "key_code": "q" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": { "is_keyboard": true },
                    "simple_modifications": [
                        {
                            "from": { "apple_vendor_top_case_key_code": "keyboard_fn" },
                            "to": [{ "key_code": "left_control" }]
                        },
                        {
                            "from": { "key_code": "left_control" },
                            "to": [{ "apple_vendor_top_case_key_code": "keyboard_fn" }]
                        }
                    ]
                }
            ],
            "name": "Solo Layout",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "iso" }
        }
    ]
}
