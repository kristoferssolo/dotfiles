{{- /* Profiles: desktop, laptop, x11, x11-laptop, mac. */ -}}
{{- if eq .profile "mac" }}
# Only deploy the selected shell, terminal, and editor configs on a work Mac.
**
!.config
{{ range list "atuin" "bat" "rio" "ideavim" "lazygit" "starship" -}}
!.config/{{ . }}
!.config/{{ . }}/**
{{ end -}}
!.config/fish
!.config/fish/config.fish
!.config/fish/fish_plugins
!.config/fish/startup.fish
!.config/fish/completions
{{ range list "atuin" "bat" "chezmoi" -}}
!.config/fish/completions/{{ . }}.fish
{{ end -}}
!.config/fish/functions
!.config/fish/functions/**
!.config/fish/conf.d
# Only portable Fish snippets, plus the work environment.
{{ range list "00-mac" "10-cursor" "auto-venv" "colors" "fnm" "fzf" "no-greeting" "thefuck" -}}
!.config/fish/conf.d/{{ . }}.fish
{{ end -}}
{{- else }}
.config/fish/conf.d/00-mac.fish
{{- end }}
{{- if not (or (eq .profile "desktop") (eq .profile "laptop")) }}
.config/ashell/**
.config/gtklock/**
.config/hypr/**
.config/mako/**
.config/niri/**
.config/swaylock/config
.config/waybar/**
.config/xdg-desktop-portal/**
.config/xdg-desktop-portal-termfilechooser/**
{{- end }}
{{- if not (or (eq .profile "x11") (eq .profile "x11-laptop")) }}
.config/awesome/**
.config/dunst/**
.config/picom/picom.conf
.config/rofi/**
.config/x11/**
.config/zsh/.zprofile
{{- end }}
# Repository metadata and development tooling must not be deployed to $HOME.
.gitignore
LICENSE
README.md
docs/**
chezmoi.toml.example
justfile
taplo.toml
bacon.toml

# These are repository fixtures or configurations that Dotter did not deploy.
.config/fish/fish_variables
.config/fish/themes
.config/yazi/flavors
.config/yazi/plugins
